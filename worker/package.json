{
  "name": "slopmatch-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 execute slopmatch --local --file schema.sql",
    "db:remote": "wrangler d1 execute slopmatch --remote --file schema.sql",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4"
  }
}
