{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slopmatch",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // bundle .md/.html as strings: the skill (/skill/SKILL.md), agent instructions (/, /llms.txt) and the landing page
  "rules": [{ "type": "Text", "globs": ["**/*.md", "**/*.html"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slopmatch",
      "database_id": "45d4101d-53c8-4270-8557-f10d281ec21c"
    }
  ],
  // binaries served at /dl/<name>; create with: bunx wrangler r2 bucket create slopmatch-bin
  "r2_buckets": [{ "binding": "BIN", "bucket_name": "slopmatch-bin" }],
  // the zone must be on your Cloudflare account; deploy attaches the domain and its certificate
  "routes": [{ "pattern": "slopmatch.lol", "custom_domain": true }]
}
